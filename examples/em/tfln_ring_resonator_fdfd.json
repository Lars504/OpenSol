{
  "title": "TFLN ring resonator, frequency domain (FDFD)",
  "version": 1,
  "parameters": [
    {"name": "lambda0", "expression": "1550*nm",
     "description": "wavelength of a stationary solve (the frequency_domain study solves lambda_start..lambda_stop)"},
    {"name": "w_wg", "expression": "450*nm", "description": "bus and ring waveguide width"},
    {"name": "r_ring", "expression": "5*um", "description": "ring radius (centre line)"},
    {"name": "gap", "expression": "250*nm", "description": "bus-to-ring edge-to-edge gap"},
    {"name": "margin", "expression": "1.5*um", "description": "cladding between the structure and the PML"},
    {"name": "Lx", "expression": "2*(r_ring + w_wg/2 + margin)", "description": "domain width; the bus runs along x"},
    {"name": "y_bus", "expression": "margin", "description": "bus centre line"},
    {"name": "y_ring", "expression": "y_bus + w_wg + gap + r_ring", "description": "ring centre y"},
    {"name": "Ly", "expression": "y_ring + r_ring + w_wg/2 + margin", "description": "domain height"},
    {"name": "x_source", "expression": "1*um", "description": "mode source line; launches the bus mode toward +x only"},
    {"name": "x_input", "expression": "2.5*um",
     "description": "input port, between the source and the ring; fraction_negative = power reflected by the ring"},
    {"name": "x_through", "expression": "Lx - 1*um",
     "description": "through port; fraction_positive = through-port transmission"},
    {"name": "port_half_span", "expression": "1.4*um",
     "description": "half length of the port lines across the bus; the mode is < 1% of its peak at their metal ends"},
    {"name": "n_eff", "expression": 1.898,
     "description": "effective index of the bus mode at lambda0 (only for sigma_ring; the ports solve their own mode)"},
    {"name": "core_fraction", "expression": 0.817, "description": "fraction of the mode power inside the core"},
    {"name": "round_trip_loss", "expression": 0.12,
     "description": "artificial power loss fraction per ring round trip (near critical coupling; 0 = lossless)"},
    {"name": "sigma_ring",
     "expression": "-log(1 - round_trip_loss)*n_eff/(mu0_const*c_const*core_fraction*2*pi*r_ring)",
     "description": "ring conductivity in S/m giving round_trip_loss"},
    {"name": "lambda_start", "expression": "1532*nm",
     "description": "first solved wavelength; lambda_start..lambda_stop is a little over one free spectral range (35 nm)"},
    {"name": "lambda_stop", "expression": "1568*nm", "description": "last solved wavelength"}
  ],
  "domain": {"size_x": "Lx", "size_y": "Ly"},
  "geometry": [
    {"name": "bus", "kind": "rectangle",
     "params": {"x0": 0.0, "y0": "y_bus - w_wg/2", "x1": "Lx", "y1": "y_bus + w_wg/2"}},
    {"name": "ring_outer", "kind": "circle", "params": {"cx": "Lx/2", "cy": "y_ring", "r": "r_ring + w_wg/2"}},
    {"name": "ring_inner", "kind": "circle", "params": {"cx": "Lx/2", "cy": "y_ring", "r": "r_ring - w_wg/2"}},
    {"name": "ring", "kind": "difference", "params": {"base": "ring_outer", "subtract": ["ring_inner"]}},
    {"name": "source_line", "kind": "line",
     "params": {"x0": "x_source", "y0": "y_bus - port_half_span", "x1": "x_source", "y1": "y_bus + port_half_span"}},
    {"name": "input_line", "kind": "line",
     "params": {"x0": "x_input", "y0": "y_bus - port_half_span", "x1": "x_input", "y1": "y_bus + port_half_span"}},
    {"name": "through_line", "kind": "line",
     "params": {"x0": "x_through", "y0": "y_bus - port_half_span", "x1": "x_through",
                "y1": "y_bus + port_half_span"}},
    {"name": "ring_point", "kind": "point", "params": {"x": "Lx/2", "y": "y_ring + r_ring"}}
  ],
  "selections": [],
  "materials": [
    {"name": "cladding", "library": "silica", "properties": {}, "dispersion": null, "selection": ["all"]},
    {"name": "bus_core", "library": "lithium_niobate_z_cut", "properties": {}, "dispersion": null,
     "selection": ["bus"]},
    {"name": "ring_core", "library": "lithium_niobate_z_cut", "properties": {"sigma_e": "sigma_ring"},
     "dispersion": null, "selection": ["ring"]}
  ],
  "physics": [
    {
      "name": "em",
      "type": "em_fdfd_ez",
      "settings": {"wavelength": "lambda0"},
      "features": [
        {"name": "source", "type": "mode_source", "selection": ["source_line"],
         "params": {"mode_number": 1, "direction": "positive", "power": 1.0, "phase": 0.0},
         "enabled": true},
        {"name": "input_port", "type": "mode_monitor", "selection": ["input_line"],
         "params": {"mode_number": 1}, "enabled": true},
        {"name": "through_port", "type": "mode_monitor", "selection": ["through_line"],
         "params": {"mode_number": 1}, "enabled": true},
        {"name": "ring_probe", "type": "field_probe", "selection": ["ring_point"],
         "params": {"component": "ez"}, "enabled": true}
      ],
      "every": 1
    }
  ],
  "couplings": [],
  "mesh": {"mode": "uniform", "dx": "25*nm", "max_ratio": 1.15, "wavelength_min": null,
           "points_per_wavelength": 20.0, "refinements": []},
  "study": {"type": "frequency_domain",
            "settings": {"wavelength_start": "lambda_start", "wavelength_stop": "lambda_stop", "n_wavelengths": 73},
            "stored_fields": ["em.ez_abs"], "sweep": null},
  "derived_values": []
}
