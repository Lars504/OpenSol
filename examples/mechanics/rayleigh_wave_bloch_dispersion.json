      "expression": "1*um",
      "description": "period along x [m]"
    },
    {
      "name": "depth",
      "expression": "12*um",
      "description": "slab depth (Fixed bottom) [m]"
    },
    {
      "name": "h_mesh",
      "expression": "0.25*um",
      "description": "triangle size [m]"
    },
    {
      "name": "k_fraction",
      "expression": 0.5,
      "description": "Bloch kx in units of 2 pi / L (swept 0.2-0.5)"
    },
    {
      "name": "k_x",
      "expression": "k_fraction*2*pi/L_p",
      "description": "Bloch wavenumber [rad/m]"
    },
    {
      "name": "mu_s",
      "expression": "E_s/(2*(1 + nu_s))",
      "description": "shear modulus [Pa]"
    },
    {
      "name": "c_T",
      "expression": "sqrt(mu_s/rho_s)",
      "description": "shear wave speed [m/s]"
    },
    {
      "name": "c_R",
      "expression": "c_T*sqrt(2 - 2/sqrt(3))",
      "description": "Rayleigh wave speed of a Poisson solid (nu = 0.25) [m/s]"
    },
    {
      "name": "f_R",
      "expression": "c_R*k_x/(2*pi)",
      "description": "Rayleigh frequency at k_x [Hz]"
    }
  ],
